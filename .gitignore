# Godot
.godot/
.import/
# .import files are committed (texture compression settings)
*.translation
*.apk
*.aab
build/
android/build/

# Raw downloads and Blender build files (22 GB, re-fetched by tools/art/fetch_assets.py and tools/terrain)
assets/_raw/*
!assets/_raw/dem/
assets/_raw/dem/*
!assets/_raw/dem/SOURCE.md
!assets/_raw/dem/cop30/
assets/_raw/dem/cop30/*
!assets/_raw/dem/cop30/SOURCE.md

__pycache__/
*.pyc
.DS_Store
!assets/_raw/.gdignore

# Designer drop zone (2.5 GB); the game uses copies in assets/models/
assets/incoming/

# Beauty corner: build-time inputs only (copied from assets/incoming; the scene uses the meshes saved
# by tools/spike/build_corner.gd in assets/models/corner/baked/ and the extracted textures)
assets/models/corner/rocks/*.glb
assets/models/corner/rocks/*.glb.import
assets/models/corner/props/*.glb
assets/models/corner/props/*.glb.import
assets/models/corner/trees/downy_birch_*.glb
assets/models/corner/trees/downy_birch_*.glb.import
